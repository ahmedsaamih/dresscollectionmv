// Many Maldives — Prisma schema
// Modeled on lib/types.ts (the API contract). Internal/external IDs are kept as
// strings so existing seed IDs and front-end references line up 1:1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Store / Catalog ─────────────────────────────────────────────────────────

// Singleton row (id = "singleton"). Maps to StoreSetting.
model Setting {
  id               String  @id @default("singleton")
  storeName        String
  tagline          String
  email            String
  adminEmail       String  @default("") // destination for the "new quote" admin-alert email; falls back to ADMIN_EMAIL env var when empty
  phone            String
  address          String
  bank             String
  bankAccounts     Json?   // [{ name: string, accountNumber: string }]
  builderFields    Json?   // [{ id, label, type: 'text'|'select'|'checkbox', options?: string[], required?: boolean, placeholder?: string }]
  currency         String  @default("MVR")
  pickupEnabled    Boolean @default(true)
  deliveryFee      Int     @default(75)
  heroTitle        String
  heroSub          String
  heroImage        String  @default("")
  heroImages       Json?   // string[] of homepage hero carousel image URLs; admin-managed
  workshopImage    String  @default("")
  categoryReadyImage        String @default("") // background photo for the "Ready-Made" homepage category card
  categoryCustomImage       String @default("") // background photo for the "Custom Jersey" homepage category card
  categoryCasualImage       String @default("") // background photo for the "Casual Wear" homepage category card
  categoryAccessoriesImage  String @default("") // background photo for the "Accessories" homepage category card
  customizationGuidePdfUrl     String @default("") // admin-uploaded logo/placement guide PDF, downloadable from the product page
  customizationTemplateXlsxUrl String @default("") // admin-uploaded Excel details template, downloadable from the product page
  storefrontCopy   Json?
  sizeChart        Json? // { note, tables: [{ id, name, columns[], rows[][] }] } — admin-editable
  taxId            String  @default("")
  taxRate          Float   @default(0)
  taxLabel         String  @default("GST")
  termsConditions  String  @default("")
  googleDriveUploadsEnabled Boolean @default(false)
  googleDriveFolderId       String  @default("")
  googleDriveFolderName     String  @default("")
  googleDriveLastTestAt     DateTime?
  googleDriveRefreshToken   String  @default("") // OAuth user-delegation refresh token; never sent to the client
  googleDriveConnectedEmail String  @default("") // email of the Google account that authorized uploads
  telegramBotToken       String    @default("") // encrypted at rest (lib/crypto.ts); never sent to the client
  telegramChatId         String    @default("")
  telegramBotUsername    String    @default("") // populated after a successful test, e.g. "MyStoreAlertsBot"
  telegramAlertsEnabled  Boolean   @default(false)
  telegramLastTestAt     DateTime?
  // Email (Resend) — key encrypted at rest (lib/crypto.ts); never sent to the client.
  emailApiKey           String    @default("") // encrypted
  emailFromUser         String    @default("") // local part only, e.g. "orders" -> orders@<EMAIL_SENDING_DOMAIN>
  emailFromName         String    @default("")
  emailAlertsEnabled    Boolean   @default(false)
  emailLastTestAt       DateTime?
  // SMS (MsgOwl) — key encrypted at rest (lib/crypto.ts); never sent to the client.
  msgowlApiKey          String    @default("") // encrypted
  msgowlSenderId        String    @default("")
  smsAlertsEnabled      Boolean   @default(false)
  smsLastTestAt         DateTime?
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Delivery-tracking log for outbound customer notifications (email + SMS).
// Written best-effort by lib/notify's CompositeNotifier — never blocks the
// send path. Rate-limit skips are NOT logged here (see lib/notify/sms-guard.ts)
// to avoid turning this table into an attack-amplified growth vector.
model NotificationLog {
  id                String    @id @default(cuid())
  channel           String // 'email' | 'sms'
  event             String // 'order.placed' | 'order.status' | 'quote.requested' | ...
  orderRef          String? // → Order.id; nullable (quotes have no Order row)
  recipient         String // email address or phone number
  provider          String // 'resend' | 'msgowl' | 'noop'
  providerMessageId String? // e.g. MsgOwl's message id, used to poll delivery status
  status            String    @default("sent") // 'sent' | 'delivered' | 'failed' | 'skipped' (channel disabled/unconfigured — provider was noop)
  error             String?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime @updatedAt

  @@index([channel])
  @@index([orderRef])
  @@index([status])
  @@index([createdAt])
}

// Per-event Email/SMS toggle for customer-facing notifications, configured
// from Admin → Settings → Notification preferences. `event` is one of the
// Notifier interface's method names (e.g. 'orderPlaced', 'quotePriced') —
// intentionally a different naming scheme than NotificationLog.event's
// dotted format ('order.placed'), since the two serve different purposes
// (pref lookup vs. log filtering) and don't need to match. Both default true
// so nothing changes until an admin explicitly disables something; a missing
// row (before the seed migration runs, or for an unrecognized event) is
// treated as "both enabled" by lib/notify's resolveChannelPref().
model NotificationChannelPref {
  event        String  @id
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(true)
}

model Collection {
  id          String     @id
  key         String     @unique // slug, e.g. "ready"
  label       String
  bespoke     Boolean    @default(false) // true = semi/full customize modals; false = standard listing
  sizeChartId String? // → SizeChart.id; null = falls back to the default chart
  sizeChart   SizeChart? @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  categories  Category[]

  @@index([sizeChartId])
}

// Standalone, assignable size chart (e.g. "Adult", "Kids"). Collections without
// an assignment fall back to whichever chart has isDefault = true.
model SizeChart {
  id          String       @id @default(cuid())
  name        String
  note        String       @default("")
  columns     Json // string[]
  rows        Json // string[][]
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  collections Collection[]
}

model Category {
  id            String     @id
  name          String
  collectionKey String // → Collection.key
  count         Int        @default(0)
  collection    Collection @relation(fields: [collectionKey], references: [key], onDelete: Cascade)

  @@index([collectionKey])
}

enum ProductStatus {
  active
  soldout
  draft
}

model Product {
  id           String        @id
  name         String
  collection   String // → Collection.key
  category     String // → Category.name
  sub          String
  price        Int
  was          Int? // compare-at
  costPrice    Int           @default(0) // super-admin-only; hidden from staff and the public catalog
  stock        Int           @default(0)   // kept for migration period; computed from Inventory
  status       ProductStatus @default(active)
  badge        String? // "New" | "Sale" | null
  colors       String[]
  sizes        String[]      // derived: keys of sizeStock where qty > 0
  sizeStock    Json          @default("{}") // kept for migration period; source of truth is Inventory
  sleeves      String[]      @default([])   // available sleeve labels
  necks        String[]      @default([])   // available collar/neck labels
  materials    String[]      @default([])   // available material names (office wear, free-form)
  sleeveImages      Json @default("{}") // Record<sleeveLabel, imgCss>
  colorImages       Json @default("{}") // Record<colorName, imgCss>
  sleeveAdjustments Json @default("{}") // Record<sleeveLabel, deltaMVR>
  sizeAdjustments   Json @default("{}") // Record<sizeLabel, deltaMVR>
  descriptionSections Json @default("[]") // ProductSection[] — optional, admin-authored page text
  customizable   Boolean       @default(false)
  showInWebStore Boolean       @default(true)  // false = POS-only, never shown on storefront
  img            String // gradient placeholder → real URL later
  inventory      Inventory[]
  placements     InventoryPlacement[]
  transfers      StockTransfer[]
  adjustments    StockAdjustment[]
  customizationAssignments CustomizationProfileAssignment[]
  quoteItems     QuoteItem[]

  @@index([collection])
  @@index([showInWebStore])
}

model CustomizationProfile {
  id          String                           @id @default(cuid())
  name        String
  description String                           @default("")
  active      Boolean                          @default(true)
  sortOrder   Int                              @default(0)
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  fields      CustomizationField[]
  assignments CustomizationProfileAssignment[]

  @@index([active])
  @@index([sortOrder])
}

model CustomizationField {
  id          String               @id @default(cuid())
  profileId   String
  label       String
  type        String
  required    Boolean              @default(false)
  helpText    String               @default("")
  placeholder String               @default("")
  options     String[]             @default([])
  sortOrder   Int                  @default(0)
  profile     CustomizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([sortOrder])
}

model CustomizationProfileAssignment {
  id            String               @id @default(cuid())
  profileId     String
  scope         String
  collectionKey String?
  categoryId    String?
  productId     String?
  createdAt     DateTime             @default(now())
  profile       CustomizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product       Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([scope])
  @@index([collectionKey])
  @@index([categoryId])
  @@index([productId])
}

// ─── Inventory & Locations ────────────────────────────────────────────────────

model Location {
  id           String      @id @default(cuid())
  name         String
  showOnWeb    Boolean     @default(false) // stock here contributes to storefront visibility
  isWebDefault Boolean     @default(false) // web checkout depletes stock from this location
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  inventory     Inventory[]
  placements    InventoryPlacement[]
  salesOrders   Order[]
  transfersFrom StockTransfer[]   @relation("TransferFrom")
  transfersTo   StockTransfer[]   @relation("TransferTo")
  adjustments   StockAdjustment[]
}

model InventoryPlacement {
  id               String   @id @default(cuid())
  locationId       String
  productId        String
  physicalLocation String   @default("")
  updatedAt        DateTime @updatedAt
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
  @@index([locationId])
}

model Inventory {
  id         String   @id @default(cuid())
  locationId String
  productId  String
  size       String   @default("") // "" for products without configured sizes
  color      String   @default("") // "" for products without configured colors (or pre-migration/unassigned stock)
  qty        Int      @default(0)
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId, size, color])
  @@index([productId])
  @@index([locationId])
}

model StockTransfer {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  productId String
  size      String   @default("")
  color     String   @default("")
  qty       Int
  note      String?
  actor     String   // admin email
  createdAt DateTime @default(now())
  from      Location @relation("TransferFrom", fields: [fromId], references: [id])
  to        Location @relation("TransferTo", fields: [toId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@index([fromId])
  @@index([toId])
  @@index([productId])
  @@index([createdAt])
}

// Corrections, write-offs, found stock — anything that isn't a sale or transfer.
model StockAdjustment {
  id         String   @id @default(cuid())
  locationId String
  productId  String
  size       String   @default("")
  color      String   @default("")
  qty        Int      // positive = add, negative = write-off
  reason     String   @default("correction") // "correction" | "damage" | "write_off" | "found"
  note       String?
  actor      String
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@index([locationId])
  @@index([productId])
  @@index([createdAt])
}

// ─── Builder options (quote-only, no prices) ─────────────────────────────────

model BuilderType {
  id    String @id
  label String
  desc  String
}

model BuilderFabric {
  id   String @id
  name String
  desc String
  img  String @default("") // greyscale texture URL; tinted by jersey color in 3D viewer
}

model BuilderSleeve {
  id    String @id
  label String
}

model BuilderNeck {
  id    String @id
  label String
}

model BuilderColor {
  id   String @id
  name String
  hex  String
}

model BuilderSize {
  id    String @id
  label String
}

// ─── Orders (fixed-price) ────────────────────────────────────────────────────

enum OrderMethod {
  Pickup
  Delivery
}

model Order {
  id           String      @id // ref, e.g. "MM-26-48213"
  customer     String
  email        String
  mobile       String?
  items        String // human-readable summary (UI reads this)
  subtotal     Int         @default(0) // product subtotal before discount
  discountCode String? // applied promo/referral code (snapshot)
  discount     Int         @default(0) // discount amount applied (MVR)
  deliveryFee  Int         @default(0) // delivery fee snapshot charged for this order
  deliveryAreaId String? // → DeliveryArea.id; set when method = Delivery
  total        Int // subtotal + fee − discount
  method       OrderMethod
  stage        Int         @default(0) // 0=Placed 1=In Production 2=Ready for Pickup 3=Ready for Delivery 4=Out for Delivery 5=Completed 6=Cancelled (restocks Inventory on transition in; irreversible)
  readyForDeliveryAt DateTime?
  paid         Boolean     @default(false)
  paidCash     Int         @default(0) // MVR collected in cash at POS
  paidCard     Int         @default(0) // MVR collected via card terminal
  paidTransfer Int         @default(0) // MVR received by bank transfer (admin marks)
  source       String      @default("web") // "web" | "pos"
  origin       String      @default("web_checkout") // "web_checkout" | "pos_sale" | "manual_order" | "quote_conversion"
  locationId   String?
  discountNote String?     // free-text reason for manual POS discounts
  address      String?
  notes        String?
  date         String // display date, e.g. "12 Jun 2026"
  pdfUrl       String?
  quoteRef     String? // set when order was converted from a quote (→ Quote.id)
  createdAt    DateTime    @default(now())
  lineItems    OrderItem[]
  receipts     Receipt[]
  redemption   Redemption?
  review       Review?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  deliveryArea DeliveryArea? @relation(fields: [deliveryAreaId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([source])
  @@index([origin])
  @@index([locationId])
  @@index([deliveryAreaId])
}

// Named delivery zones with their own rate (e.g. Male City, Hulhumale, Ferry and Boats),
// replacing the old flat Setting.deliveryFee.
model DeliveryArea {
  id        String   @id @default(cuid())
  name      String
  rate      Int // MVR
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  orders    Order[]
}

// ─── Promo / referral codes ──────────────────────────────────────────────────

enum DiscountType {
  percent
  fixed
}

// What a code applies to.
enum PromoScope {
  all
  collection
  category
}

// How a referrer's compensation is calculated for each redemption.
enum CommissionType {
  none
  percent_of_order // % of the order's product subtotal
  percent_of_discount // % of the discount given to the customer
  fixed // flat MVR per redemption
}

model PromoCode {
  id              String         @id @default(cuid())
  code            String         @unique // stored uppercase; what the customer enters
  description     String?
  discountType    DiscountType
  discountValue   Int // percent (1..100) or fixed MVR
  scope           PromoScope     @default(all)
  scopeValue      String? // collection key or category name (null when scope = all)
  minSubtotal     Int            @default(0) // minimum eligible subtotal to apply
  maxRedemptions  Int? // usage cap (null = unlimited)
  expiresAt       DateTime?
  active          Boolean        @default(true)
  // referral / compensation
  referrer        String? // who is compensated for redemptions of this code
  commissionType  CommissionType @default(none)
  commissionValue Int            @default(0)
  // denormalised
  timesUsed       Int            @default(0)
  createdAt       DateTime       @default(now())
  redemptions     Redemption[]

  @@index([referrer])
}

// One immutable record per applied code — the source of truth for referrer payouts.
model Redemption {
  id         String     @id @default(cuid())
  codeId     String?
  code       String // snapshot of the code string
  orderId    String     @unique
  subtotal   Int // order product subtotal
  eligible   Int // eligible subtotal the discount applied to
  discount   Int // discount given to the customer (MVR)
  referrer   String? // snapshot
  commission Int        @default(0) // computed referrer compensation (MVR), snapshotted
  createdAt  DateTime   @default(now())
  promoCode  PromoCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([codeId])
  @@index([referrer])
  @@index([createdAt])
}

// Maps to FixedLineItem.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  sku     String
  name    String
  meta    String
  price   Int
  img     String
  size    String
  color   String
  sleeve  String @default("")
  neck    String @default("")
  qty     Int    @default(1)
  customizationNote  String @default("")   // free-text customization instructions (POS, customizable products only)
  customizationLines Json   @default("[]") // Array<{ label: string; cost: number }> — POS-entered cost breakdown
  customizationCost  Int    @default(0)    // sum of customizationLines[].cost — flat, NOT multiplied by qty
  stockDecremented   Boolean @default(false) // true iff this line actually decremented Inventory at order-creation time
  sizeBreakdown      Json?                    // { [size]: qty } — quote-conversion lines only, spanning multiple sizes behind one collapsed row; null elsewhere (size/qty are authoritative)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Order payment documents: customer-uploaded payment slips and generated payment receipts.
model Receipt {
  id        String    @id @default(cuid())
  orderId   String
  url       String
  kind      String    @default("payment_slip") // "payment_slip" | "payment_receipt"
  createdAt DateTime  @default(now())
  expiresAt DateTime? // set for payment_slip (R2 lifecycle rule deletes the object at this time); null for payment_receipt, kept indefinitely
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([kind])
}

// ─── Quotes (custom, no price until admin sets it) ───────────────────────────

enum QuoteCustomerDecision {
  pending
  confirmed
  rejected
}

model Quote {
  id        String      @id // ref, e.g. "QT-26-10293"
  customer  String
  email     String
  mobile    String?
  configs   Int         @default(0)
  units     Int         @default(0)
  summary   String
  stage     Int         @default(0) // 0..3
  price     Int? // admin-set final/negotiated price; null until sent; pre-filled from computedPrice but overridable
  computedPrice Int     @default(0) // server-maintained sum of lineItems (unitPrice*units + customizationCost); never manually edited
  message   String?
  date      String
  pdfUrl    String?
  createdAt DateTime    @default(now())
  lineItems QuoteItem[]
  artworks  Artwork[]
  changeRequests QuoteChangeRequest[]

  // Customer confirm/reject link, independent of `stage` — set when admin
  // sends a priced quote for confirmation; single-use, expires after
  // 1/2/3 admin-chosen days (see lib/quote-confirmation.ts).
  customerDecision           QuoteCustomerDecision @default(pending)
  confirmationToken          String?               @unique
  confirmationTokenExpiresAt DateTime?
  sentForConfirmationAt      DateTime?
  respondedAt                DateTime?

  // Payment slip uploaded by the customer after confirming the quote (before
  // an Order exists). Single-use, mirrored by /api/quotes/[id]/receipts.
  paymentSlipUrl        String?
  paymentSlipUploadedAt DateTime?

  @@index([email])
}

// ─── Customers (derived/deduped from Order + Quote contact info) ────────────

model Customer {
  id        String   @id
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum ReviewStatus {
  pending
  approved
  rejected
}

// Created (token + expiry, no content yet) when an online order reaches
// Completed; filled in when the customer submits via the emailed link.
// Admin then approves/rejects and may mark it featured for the homepage.
model Review {
  id             String       @id @default(cuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id])

  token          String       @unique
  tokenExpiresAt DateTime

  rating         Int?
  quote          String?
  authorName     String?
  authorRole     String?
  submittedAt    DateTime?

  status         ReviewStatus @default(pending)
  featured       Boolean      @default(false)
  resolvedBy     String?
  resolvedAt     DateTime?
  rejectionNote  String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([featured])
}

enum QuoteChangeRequestStatus {
  pending
  accepted
  rejected
}

// A manager/pos_user's attempted stage/price change on an Approved (stage 3)
// quote is queued here instead of applied directly; only admin/quotation_approver
// can accept or reject it.
model QuoteChangeRequest {
  id             String                   @id @default(cuid())
  quoteId        String
  requestedBy    String                   // admin email of the requester
  currentStage   Int                      // snapshot of Quote.stage at request time
  currentPrice   Int?                     // snapshot of Quote.price at request time
  requestedStage Int?                     // null = this request doesn't touch stage
  requestedPrice Int?                     // null = this request doesn't touch price
  status         QuoteChangeRequestStatus @default(pending)
  resolvedBy     String?
  resolvedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime                 @default(now())
  quote          Quote                    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([status])
}

// Maps to QuoteLineItem.
model QuoteItem {
  id         String  @id @default(cuid())
  quoteId    String
  kind       String // "jersey" | "casual"
  name       String
  specs      String
  units      Int     @default(0)
  sizesLabel String
  sizes      Json
  swatch     String
  // jersey-specific
  type       String?
  fabric     String?
  sleeve     String?
  neck       String?
  collar     Boolean?
  accent     String?
  logoName   String?
  notes      String?
  // casual-print-specific
  placement  String? // "front" | "back" | "both" | "sleeve"
  artName    String?
  customizationProfileId   String?
  customizationProfileName String?
  customizationAnswers     Json    @default("{}")
  // pricing — derived from a real catalog product, plus manually-entered extra costs (e.g. design/printing)
  productId          String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  colorName           String? // one of product.colors — the real Inventory color key; `swatch` above is a display-only hex, not usable for stock lookups
  unitPrice           Int     @default(0) // product.price + sleeveAdjustments[sleeve], snapshotted server-side
  customizationLines  Json    @default("[]") // Array<{ label: string; cost: number }> — admin-entered extra costs
  customizationCost   Int     @default(0) // sum of customizationLines[].cost
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([productId])
}

// Uploaded artwork/logo for a quote (R2 in prod, local in dev).
model Artwork {
  id        String   @id @default(cuid())
  quoteId   String
  url       String
  name      String?
  provider  String   @default("local")
  fileId    String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// ─── Infrastructure ──────────────────────────────────────────────────────────

// Atomic sequential reference generation (replaces random genRef()).
// One row per (prefix, year): "MM"+"26", "QT"+"26", ...
model RefSequence {
  prefix    String // "MM" | "QT"
  year      String // "26"
  lastValue Int    @default(0)

  @@id([prefix, year])
}

enum AdminRole {
  admin
  staff
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(admin)
  permissions  Json      @default("{}") // ModuleKey -> 'none'|'read'|'edit', ignored for role: admin
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // admin email
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
