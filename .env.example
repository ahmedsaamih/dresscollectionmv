# Copy to .env and fill in. Every value here is read via process.env
# somewhere in the codebase (see lib/*, app/api/*, prisma/schema.prisma).

# Database (Neon Postgres) — DIRECT_URL is the unpooled connection Prisma
# migrations need; DATABASE_URL is the pooled connection the app uses at runtime.
DATABASE_URL=
DIRECT_URL=

# Auth
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# Encrypts secrets stored in the DB (the Resend/MsgOwl/Telegram credentials in
# Setting — see lib/crypto.ts). 32 bytes as 64 hex chars or base64, e.g.
# `openssl rand -hex 32`. Required in production; local dev falls back to a
# fixed dev-only key if unset.
SETTINGS_ENCRYPTION_KEY=

# App — used to build absolute links (email links, etc).
APP_URL=http://localhost:3000

# Email (Resend, https://resend.com/docs/api-reference/emails). EMAIL_DRIVER=noop
# just logs to the console — no email is sent. Prefer configuring this from
# Admin → Settings → "Email (Resend)" instead of these env vars — the UI lets
# you paste your Resend API key, set the "send from" username, and test the
# connection without a redeploy, and once a key is saved there it takes over
# entirely. These env vars are only a fallback used until that's done (and
# since Resend has no prior usage in this codebase, leaving them unset just
# means email stays off until the admin fills in the Settings card).
EMAIL_DRIVER=noop
RESEND_API_KEY=
# The sending domain — requires DNS + Resend domain verification (SPF/DKIM),
# so it can't be set from the Settings page. Real deliveries will fail until
# this domain is verified in Resend's dashboard, independent of any code change.
EMAIL_SENDING_DOMAIN=example.com

# SMS (MsgOwl transactional SMS, https://www.msgowl.com/docs). SMS_DRIVER=noop
# (default) just logs to the console — no SMS is sent. Prefer configuring
# this from Admin → Settings → "SMS Gateway (MsgOwl)" instead of these env
# vars — the UI lets you paste your API key, set the Sender ID, and test the
# connection without a redeploy, and once a key is saved there it takes over
# entirely. These env vars are only a fallback used until that's done.
SMS_DRIVER=noop
MSGOWL_API_KEY=
MSGOWL_SENDER_ID=

# SMS abuse guarding (lib/notify/sms-guard.ts). These budgets are IP-independent
# so an attacker can't bypass them by rotating IPs/emails — MsgOwl's own
# account-wide cap is 50 POST/60s, so keep SMS_RATE_LIMIT_PER_MIN under that.
SMS_RATE_LIMIT_PER_MIN=10
SMS_DAILY_LIMIT=60
SMS_PER_PHONE_DAILY_LIMIT=3

# Admin alerts (Telegram) — staff-only notifications (new orders/quotes, status
# changes), never sent to customers. Prefer configuring this from Admin →
# Settings → "Telegram staff alerts" instead of these env vars — the UI lets
# you paste a bot token, auto-detect the group chat ID, and test the
# connection without a redeploy, and once a token is saved there it takes
# over entirely. These env vars are only a fallback used until that's done.
# ADMIN_ALERT_DRIVER=noop (default) just logs to the console. Create a bot via
# @BotFather to get TELEGRAM_BOT_TOKEN; TELEGRAM_CHAT_ID is the numeric
# chat/group id the bot should post to (message @userinfobot, or add the bot
# to a group and GET https://api.telegram.org/bot<token>/getUpdates after
# sending it a message, to find the id).
ADMIN_ALERT_DRIVER=noop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage — default driver for every bucket (site, product, receipt, pdf).
# Values: local (dev, writes to LOCAL_STORAGE_DIR) | blob | r2.
# On Vercel (Hobby plan), set this to `r2` and fill in the R2_* vars below —
# every bucket moves to Cloudflare R2, which keeps Vercel Blob usage at zero.
# `blob` is kept as a dormant option (was the original default) but shouldn't
# be used in production going forward — R2's free tier and native bucket
# lifecycle rules (auto-delete payment slips after 90 days, see
# lib/receipts.ts) are why R2 replaced it.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# Per-bucket override — only needed if a specific bucket should use a
# different driver than STORAGE_DRIVER above. Uncomment only what you're
# overriding.
# STORAGE_DRIVER_SITE=
# STORAGE_DRIVER_PRODUCT=
# STORAGE_DRIVER_RECEIPT=
# STORAGE_DRIVER_PDF=

# Cloudflare R2 — required once STORAGE_DRIVER=r2 (or any per-bucket override
# above is set to r2). R2_PUBLIC_BASE_URL is either an r2.dev public bucket
# URL or a custom domain mapped to the bucket. Also set a bucket Lifecycle
# Rule in the Cloudflare dashboard: objects under the `receipt/` prefix expire
# after 90 days — that's what actually deletes payment-slip uploads; nothing
# in the app does it (no Vercel Cron is used anywhere in this project).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
